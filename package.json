{
  "name": "claude-skills-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "typecheck": "bun --bun tsc",
    "build": "bun --bun tsc && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "bun run build && bun --bun vite preview --open",
    "build:plugin": "bun scripts/build-plugin.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "description": "A local dashboard for your Claude Code skills and plugins: enable/disable, install, delete, token costs and usage.",
  "license": "MIT"
}
